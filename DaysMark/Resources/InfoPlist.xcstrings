    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere ausgewählte Kalendertermine als einmalige Momentaufnahmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import calendar dates you choose as one-time snapshots."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したカレンダーの日付を、1回限りのスナップショットとして読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 캘린더 날짜를 일회성 스냅샷으로 가져와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你选择的日历日期作为一次性快照导入。"
          }
        }
      }
    },
