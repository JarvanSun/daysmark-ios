    "widget.focus.description" : {
      "comment" : "Description of the Focus widget in the widget gallery.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige deinen Fokus, ein Ereignis, eine Kategorie oder alle Ereignisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show your focus, one event, one category, or all events."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス、1つの大切な日、1つのカテゴリ、またはすべての大切な日を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스, 이벤트 하나, 카테고리 하나 또는 모든 이벤트를 표시해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示焦点、单个事项、单个类别或全部事项。"
          }
        }
      }
    },
