    "settings.widgets.adding.steps" : {
      "comment" : "Steps that add a widget.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine leere Stelle auf dem Home-Bildschirm oder Sperrbildschirm gedrückt, tippe auf „Bearbeiten“, dann auf „Widget hinzufügen“ und suche nach Daysmark."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty area on the Home Screen or Lock Screen, tap Edit, then Add Widget, and search for Daysmark."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面またはロック画面の何もないところを長押しし、「編集」、「ウィジェットを追加」の順にタップしてから、「Daysmark」を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면이나 잠금 화면의 빈 곳을 길게 터치하고 ‘편집’을 탭한 다음 ‘위젯 추가’를 탭하고 ‘날들’을 검색하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住主屏幕或锁定屏幕的空白处，轻点“编辑”，再轻点“添加小组件”，然后搜索“日子”。"
          }
        }
      }
    },
