    "settings.siri.actions.footnote" : {
      "comment" : "Footnote under what Siri and Shortcuts can do.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen, Fokusänderungen und Stapelbearbeitungen sind über Siri oder Kurzbefehle nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion, focus changes, and batch edits are not available through Siri or Shortcuts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除、フォーカスの変更、一括編集は、Siriとショートカットからは行えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제, 포커스 변경, 일괄 편집은 Siri 또는 단축어에서 사용할 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 或快捷指令不支持删除、更改焦点和批量编辑。"
          }
        }
      }
    },
    "settings.siri.privacy.message" : {
      "comment" : "Privacy note on the Siri & Shortcuts page.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri und Kurzbefehle erhalten nur die Ereignisfelder, die für deine Anfrage nötig sind."
          }
