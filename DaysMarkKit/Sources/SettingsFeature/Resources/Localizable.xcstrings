    "settings.import.source.footnote" : {
      "comment" : "Footnote under the import sources.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe sind einmalige Momentaufnahmen. Ein erneuter Scan zeigt neue und geänderte Daten und überschreibt deine Änderungen nie unbemerkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imports are one-time snapshots. Rescanning shows new and changed dates, and never silently overwrites your edits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みは1回限りのスナップショットです。再スキャンすると追加・変更された日付が表示され、あなたの編集が知らないうちに上書きされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 날짜는 일회성 스냅샷이에요. 다시 스캔하면 새로 추가되거나 변경된 날짜를 보여 주며, 편집한 내용을 임의로 덮어쓰지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入是一次性快照。重新扫描会显示新增和变化，绝不会静默覆盖你的编辑。"
          }
        }
      }
    },
