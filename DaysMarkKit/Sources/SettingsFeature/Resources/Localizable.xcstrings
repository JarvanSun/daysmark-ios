    "settings.categories.footnote" : {
      "comment" : "Footnote under the list of categories.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Kategorien lassen sich neu anordnen, aber nicht umbenennen oder löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in categories can be reordered but not renamed or deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準カテゴリは並べ替えできますが、名前の変更や削除はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 카테고리는 순서를 바꿀 수 있지만 이름을 변경하거나 삭제할 수는 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置类别可以排序，但不能重命名或删除。"
          }
        }
      }
    },
