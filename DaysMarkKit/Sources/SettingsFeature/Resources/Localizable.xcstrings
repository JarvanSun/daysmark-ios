    "settings.widgets.kinds.footnote" : {
      "comment" : "Footnote under the widgets that says how to change what one shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Widget gedrückt und wähle „Widget bearbeiten“, um ein Ereignis, den Fokus, eine Kategorie oder alle Ereignisse anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold a widget, then choose Edit Widget to show one event, the focus, a category, or all events."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットを長押しして「ウィジェットを編集」を選ぶと、1つの大切な日、フォーカス、カテゴリ、またはすべての大切な日を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯을 길게 터치한 다음 ‘위젯 편집’을 선택하면 이벤트 하나, 포커스, 카테고리 하나 또는 모든 이벤트를 표시할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住小组件，选择“编辑小组件”，即可显示单个事项、焦点、某个类别或全部事项。"
          }
        }
      }
    },
