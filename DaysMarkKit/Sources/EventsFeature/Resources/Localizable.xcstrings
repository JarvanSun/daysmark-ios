          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改于 %@"
          }
        }
      }
    },
    "detail.conflict.footer" : {
      "comment" : "Footnote of the sheet that chooses between conflicting versions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die anderen Versionen werden durch die behaltene ersetzt. Es wird nichts automatisch ausgewählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other versions are replaced by the one you keep. Nothing is chosen for you automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残したバージョンで、ほかのバージョンは置き換えられます。自動で選ばれることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남기는 버전이 다른 버전을 대체해요. 자동으로 선택되는 버전은 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留的版本会取代其他版本，不会自动替你选择。"
          }
        }
      }
    },
    "detail.conflict.keep" : {
      "comment" : "Button that keeps one of the conflicting versions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version behalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep This Version"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンを残す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전 유지"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留这个版本"
          }
        }
      }
    },
    "detail.conflict.notice" : {
      "comment" : "Notice on the event page when another device changed the event too.",
