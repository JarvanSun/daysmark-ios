          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "detail.conflict.changedAt %@" : {
      "comment" : "When a conflicting version of an event was changed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geändert am %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changed %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
