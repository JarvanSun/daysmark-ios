            "value" : "共有"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享"
          }
        }
      }
    },
    "detail.conflict.cancel" : {
      "comment" : "Button that closes the conflict sheet without choosing.",
      "localizations" : {
