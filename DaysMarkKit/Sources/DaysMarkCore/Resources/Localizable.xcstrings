    "lookup.confirmation %@ %@ %@" : {
      "comment" : "Siri confirmation before creating or editing an event, with its title, date and category.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ am %2$@ in der Kategorie %3$@ bestätigen."
