    "onboarding.welcome.message" : {
      "comment" : "Text under the title of the first onboarding step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, worauf du dich freust, und erinnere dich an wichtige Menschen und Momente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what you’re looking forward to, and remember the people and moments that matter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽しみにしている日を確かめ、大切な人やひとときを覚えておけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기다리는 날을 확인하고, 소중한 사람과 순간을 기억하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看见正在靠近的期待，记住重要的人与时刻。"
          }
        }
      }
    },
    "onboarding.welcome.title" : {
      "comment" : "Title of the first onboarding step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte wichtige Daten im Blick"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the dates that matter close"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大切な日を、いつもそばに"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소중한 날을 늘 가까이"
          }
        },
        "zh-Hans" : {
