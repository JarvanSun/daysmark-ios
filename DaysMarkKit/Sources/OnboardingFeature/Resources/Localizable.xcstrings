    "onboarding.birthday.message" : {
      "comment" : "Text under the title of the birth date step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle dein vollständiges Geburtsdatum oder überspringe diesen Schritt."
