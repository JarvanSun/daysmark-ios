    "onboarding.seeds.message" : {
      "comment" : "Text under the title of the last onboarding step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind echte Ereignisse, die du später bearbeiten, teilen oder löschen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They’re real events you can edit, share, or delete later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルではなく実際の項目なので、あとから編集、共有、削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 이벤트라서 나중에 편집, 공유하거나 삭제할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们是真实的事项，之后可以编辑、分享或删除。"
          }
        }
      }
    },
